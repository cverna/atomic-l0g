[Unit]
Description=atomic-l0g MCP server (read-only, streamable HTTP)
Documentation=file:/opt/atomic-l0g/deploy/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=atomic-l0g
Group=atomic-l0g

# NOTE: deliberately no EnvironmentFile and no GITHUB_TOKEN.
#
# This process is reachable from the network and every tool it exposes is a
# read over local data. Giving it credentials would let a public endpoint spend
# the collection API budget -- and that property, not confidentiality, is what
# makes a public endpoint defensible here. Do not add a token to this unit.
Environment=ATOMIC_L0G_DATA_DIR=/var/lib/atomic-l0g

# Same reason as the ingest unit: unbuffered output means the journal shows
# startup and per-request errors as they happen rather than at exit.
Environment=PYTHONUNBUFFERED=1

# The allow-list is exact-match or "host:*" -- there is no wildcard -- and an
# unset list means localhost only. This must name how clients actually reach
# the server, or every request is rejected with 421 and no explanation.
Environment=ATOMIC_L0G_ALLOWED_HOSTS=18.197.198.198:*,ec2-18-197-198-198.eu-central-1.compute.amazonaws.com:*

ExecStart=/opt/atomic-l0g/.venv/bin/atomic-l0g-mcp --transport streamable-http --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

# Modest hardening. Stronger options are documented in deploy/README.md.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
